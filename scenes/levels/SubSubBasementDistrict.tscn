[node name="BrickmouthRonnie" type="CharacterBody3D" parent="." groups=["district_npc"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 7.2, 0.0, -14.4)
collision_layer = 2
collision_mask = 1
script = ExtResource("11")
npc_name = "Brickmouth Ronnie"
npc_id = "brickmouth_ronnie"
wander_radius = 2.5
move_speed = 0.8
default_lines = ["Everyone owes something. I just keep the math honest with a steel jaw.", "Torai does not send me. The debt sends me. Torai merely agrees.", "My ledger terminal has better memory than most families."]
rain_lines = ["Rain washes away footprints, not obligations.", "Even the sky owes us. We are still calculating the interest.", "Chemical rain is an environmental hazard. So is missing a payment."]
sag_lines = ["Power outage does not pause your payments.", "Darkness is just another billing cycle.", "If the office lights die, I can still count on my fingers. I upgraded them for that."]
lan_lines = ["LAN outage means the network is down. The debt network never goes down.", "Surveillance is blind but my ledger sees everything.", "Ladderboy can hide cameras, not consequences."]
stable_lines = ["Stable power means the interest calculator runs smoothly. Unfortunate for you.", "A steady grid keeps receipts warm and excuses cold."]
rep_check_faction = "Wan Moa Torai"
rep_threshold = 3
high_rep_lines = ["Torai speaks highly of your credit. Enjoy it while it lasts.", "Good reputation with Torai means you have been borrowing responsibly. Suspicious, but refreshing."]
low_rep_lines = ["Your debt is unpaid. I am not threatening. I am scheduling.", "One more try became one more invoice. Funny how hope itemizes."]

