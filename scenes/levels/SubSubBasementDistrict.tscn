[node name="KikiBaja" type="CharacterBody3D" parent="." groups=["district_npc"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 5.8, 0.0, 7.4)
collision_layer = 2
collision_mask = 1
script = ExtResource("11")
npc_name = "Kiki Baja"
npc_id = "kiki_baja"
wander_radius = 3.0
move_speed = 0.7
default_lines = ["You want real food? I know a guy. The guy is me, and the case is insulated.", "Gatebox nutrient paste is a war crime. My gorditas are technically contraband relief work.", "Rival megacity recipe. Local felony. Very fair price."]
rain_lines = ["Rain ruins the cargo. My jacket is waterproof. The tortillas have feelings.", "Even smugglers take shelter. Dead smugglers deliver nothing and tip terribly.", "Chemical rain gives salsa a metallic finish. That is not a feature."]
sag_lines = ["Power outage? I have battery-powered hot sauce. Civilization survives by priorities.", "Darkness is bad for business unless you already memorized every alley and debt collector.", "If the freezers die, I become a food cart and a biohazard in the same hour."]
lan_lines = ["LAN chaos means distracted security. Best time to move cargo through the dumb parts of the grid.", "The Hoodlums and I have an understanding. I feed them, they pretend my taco case is not a server rack.", "Ladderboy pays in stolen coupons and impossible passwords. I accept one of those."]
stable_lines = ["Stable power means stable smuggling schedules. Boring, profitable, suspicious.", "The generator hums, the warmer works, and nobody asks where the meat came from."]
rep_check_faction = "Wan Moa Torai"
rep_threshold = 2
high_rep_lines = ["Torai vouches for you. That means you understand debt, or you are about to.", "Good credit with Torai? I respect a customer who can be found later."]
low_rep_lines = ["No Torai credit, no taco trust. I am charming, not doomed.", "Bad books travel faster than my delivery bike."]

