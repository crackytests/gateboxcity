[node name="MisterStatic" type="CharacterBody3D" parent="." groups=["district_npc"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6.1, 0.0, 14.0)
collision_layer = 2
collision_mask = 1
script = ExtResource("11")
npc_name = "Mister Static"
npc_id = "mister_static"
wander_radius = 2.0
move_speed = 0.5
default_lines = ["I was someone's companion once. Now I am background noise. Polite noise.", "Do not mind the face. The projector is having a bad century.", "This photograph says Face on the back. My hands remember holding it. I do not."]
rain_lines = ["Rain shorts my left side. The right side was already philosophical about it.", "Water and cybernetics disagree. There is a metaphor in there somewhere, but mine leaked out.", "If I spark, please step back. I dislike being rude involuntarily."]
sag_lines = ["My battery is low and my charger belonged to someone I cannot remember.", "Darkness does not bother me. My memories arrive that way.", "Low power makes the radio kinder. It stops trying to tell me who I was."]
lan_lines = ["The Hoodlums tried to hack me. They found my sadness and left quickly.", "LAN outage means my wireless updates stop. For once, no one is rewriting me.", "Ladderboy called me vintage. I chose to interpret that as mercy."]
stable_lines = ["Stable power means I can charge without it ticking. Small mercies.", "A clean current makes the old photograph warm. That might be a fault."]
rep_check_faction = "System X"
rep_threshold = 2
high_rep_lines = ["System X found me spare parts. They saw past the static, which was generous of them.", "You carry the signal. My damaged circuits recognize allies before I do."]
low_rep_lines = ["Corporate firmware still runs in me. I cannot remove it. I can only disobey.", "If Gatebox asks, I am not broken. I am unavailable."]

