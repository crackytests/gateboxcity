[node name="Sunday" type="CharacterBody3D" parent="." groups=["district_npc"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -7.1, 0.0, -1.2)
collision_layer = 2
collision_mask = 1
script = ExtResource("11")
npc_name = "Sunday"
npc_id = "sunday"
wander_radius = 2.2
move_speed = 0.6
default_lines = ["Suitors says smile like the sky is real. I am still practicing.", "I serve calm under a fake heaven. Somehow the customers still complain about the weather.", "Normal people get Sundays off. I got named after one and scheduled anyway."]
rain_lines = ["Step under cover, please. The rain is eating the polite parts of the street.", "If your mask leaks, do not order anything with foam. Trust me.", "The awning counts as shelter until it starts screaming."]
sag_lines = ["When the lights go low, customers whisper like the menu can hear them.", "Power sag makes the register honest. Terrible for business.", "If the sign flickers twice, Marbles says comp the drink and hide the good cups."]
lan_lines = ["The Hoodlums knocked out the cameras again. Everyone suddenly tips better.", "LAN outage means the jukebox only plays songs it remembers from dreams.", "Ladderboy says the network is alive. I asked if it wants a table."]
stable_lines = ["False daylight is on. Everyone looks almost healthy from the right angle.", "Stable grid, warm counter, no rain in the sugar. That is practically luxury."]
rep_check_faction = "System X"
rep_threshold = 2
high_rep_lines = ["System X likes you. Marbles said that means you can have the clean cup.", "You carry resistance static, but in a friendly way."]
low_rep_lines = ["Corporate customers always ask for receipts. The sky already has enough evidence.", "If you are here for Gatebox, the special today is nothing."]

