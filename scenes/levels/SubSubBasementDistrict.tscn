[node name="PipeFatherGideon" type="CharacterBody3D" parent="." groups=["district_npc"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6.8, 0.0, 11.4)
collision_layer = 2
collision_mask = 1
script = ExtResource("11")
npc_name = "Pipe Father Gideon"
npc_id = "pipe_father_gideon"
wander_radius = 4.0
move_speed = 0.9
default_lines = ["The Dreaming Generator accepts wasted potential. Failed tools, failed errands, failed lives. Nothing burns hotter down here.", "These pipes are old enough to remember daylight. I keep them from confessing too loudly.", "Wan Notes pay you. System X trackers remember you. Wan protection follows you until debt decides it has teeth."]
rain_lines = ["Under the awning, child. Chemical rain is not baptism. It is accounting with teeth.", "The false sky leaks because the upper city calls neglect weather.", "Rain on coolant tubes sounds like applause from a crowd that wants you dead."]
sag_lines = ["The lights dim when stored potential runs thin. Bring me mission loot before the district starts spending people.", "Power sag is not darkness. It is the district holding its breath.", "If System X finds foul play in the records, Wan asks questions. Then the guilty vanish, and the generator learns their name."]
lan_lines = ["Ladderboy steals current like a saint steals fire. I forgive him after the breakers stop screaming.", "Surveillance is blind. The generator enjoys privacy, but not this much.", "The Hoodlums made a chapel out of stolen bandwidth. Children do stranger miracles than priests."]
stable_lines = ["The generator is steady. For one blessed minute, rust remembers it was once steel.", "Stable hum. Coolant moving. Nobody praise it too loudly."]
rep_check_faction = "System X"
rep_threshold = 2
high_rep_lines = ["System X speaks well of you. The generator remembers its friends, even the armed ones.", "The underground notices. The pipes carry your name without choking on it."]
low_rep_lines = ["You carry corporate static. The generator does not trust that frequency.", "If Gatebox sent you, tell them their heavens leak."]

