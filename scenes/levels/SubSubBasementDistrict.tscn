[node name="VelvetCoil" type="CharacterBody3D" parent="." groups=["district_npc"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6.6, 0.0, -2.8)
collision_layer = 2
collision_mask = 1
script = ExtResource("11")
npc_name = "Velvet Coil"
npc_id = "velvet_coil"
wander_radius = 3.0
move_speed = 0.6
default_lines = ["You want upgrades? I have upgrades. Some are legal in cities that no longer exist.", "Every chrome part in this district passed through my hands. Or my spider arms.", "Do not flinch at the bone saw. It hates insecurity."]
rain_lines = ["Rain makes the chrome rust. Beautiful, tragic, and excellent for return business.", "Need a waterproof chassis mod? I have a waiting list and a towel.", "Chemical rain gives poor implants a lovely scream."]
sag_lines = ["Power dies, my surgery rig runs on batteries. The work continues with mood lighting.", "When the lights come back, everything I installed looks different. Usually better. Usually.", "Brownout anesthesia is cheaper because you remember more."]
lan_lines = ["LAN party means the kids are distracted. Good time for quiet surgery and loud mistakes.", "The Hoodlums bought my entire amber optic stock. I admire paranoia with a budget.", "If Ladderboy routes surgery cams through his backpack again, I am keeping the backpack."]
stable_lines = ["Stable power means I can actually sterilize my tools. Luxurious.", "Clean current, clean cuts, dirty invoices."]
rep_check_faction = "Gatebox Corporation"
rep_threshold = 2
high_rep_lines = ["Corporate liked my work. I am still deciding how to invoice that trauma.", "You have the corporate glow. I can see it through your skin. Literally."]
low_rep_lines = ["Anti-corporate types make the best surgery candidates. Desperate, creative, lightly insured.", "Gatebox hates what I do because I do it without a subscription."]

