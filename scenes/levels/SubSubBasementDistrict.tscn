[node name="Ladderboy" type="CharacterBody3D" parent="." groups=["district_npc"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6.7, 0.0, -14.8)
collision_layer = 2
collision_mask = 1
script = ExtResource("11")
npc_name = "Ladderboy"
npc_id = "ladderboy"
wander_radius = 4.0
move_speed = 1.3
default_lines = ["The grid belongs to whoever can hold it. Right now, that is us and my backpack.", "I am not a criminal. I am a network administrator with attitude and burn scars.", "If a cable is stolen but everyone uses it, that is infrastructure."]
rain_lines = ["Rain messes with the cables but we waterproofed the important ones. Mostly the snack line.", "Even the rain cannot stop a LAN party. Only parents can, and we jammed that frequency.", "Chemical rain improves latency if you are brave and wrong enough."]
sag_lines = ["Power sag? We have backups for our backups and lies for after those.", "The lights go out and we just glow harder.", "Generator is coughing. Tell Gideon I only borrowed enough current to become legendary."]
lan_lines = ["LAN party is LIVE. Every camera in range is ours and none of them are emotionally ready.", "If you are here to stop it, you will have to out-ping us.", "Gatebox surveillance just blinked. We named the blind spot Peewee Memorial Lane."]
stable_lines = ["Stable power means the network is clean. Almost no fun.", "Clean grid, clean packets, boring evening. I give it six minutes."]
rep_check_faction = "Gatebox Corporation"
rep_threshold = 1
high_rep_lines = ["Corporate wants us to stop? Add it to the list between homework and weather.", "You look like you work for the suits. My router says otherwise, which is weirder."]
low_rep_lines = ["Anti-corporate? We are just pro-bandwidth. But welcome anyway.", "If Gatebox hates you too, stand near the good cable."]

